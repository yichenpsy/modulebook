FROM python:3.12-slim

WORKDIR /app

COPY tools/pdf_import/requirements.txt /app/tools/pdf_import/requirements.txt
RUN pip install --no-cache-dir -r /app/tools/pdf_import/requirements.txt

COPY tools /app/tools
COPY services /app/services

EXPOSE 8000

CMD ["uvicorn", "services.pdf_import_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
